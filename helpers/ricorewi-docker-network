#!/usr/bin/env python3

import json
import re
import subprocess
import sys


NAME_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$')

PROTECTED = {
    'bridge',
    'host',
    'none',
}


def fail(message, code=2):
    print(message, file=sys.stderr)
    raise SystemExit(code)


def run(cmd, timeout=60):
    try:
        p = subprocess.run(
            cmd,
            text=True,
            capture_output=True,
            timeout=timeout
        )
    except subprocess.TimeoutExpired:
        fail(
            'Docker-Befehl hat das Zeitlimit überschritten.',
            124
        )

    output = (p.stdout + p.stderr).strip()

    if p.returncode != 0:
        fail(
            output or
            'Docker-Befehl fehlgeschlagen.',
            p.returncode
        )

    return p.stdout


def valid_name(value, label):
    value = str(value or '').strip()

    if not NAME_RE.fullmatch(value):
        fail(
            'Ungültiger ' + label + '.'
        )

    return value


def network_exists(name):
    p = subprocess.run(
        [
            'docker',
            'network',
            'inspect',
            name
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

    return p.returncode == 0


def container_exists(name):
    p = subprocess.run(
        [
            'docker',
            'container',
            'inspect',
            name
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

    return p.returncode == 0


def read_payload():
    try:
        data = json.load(sys.stdin)
    except Exception:
        fail('Ungültige JSON-Anfrage.')

    if not isinstance(data, dict):
        fail('Ungültige Anfrage.')

    return data


if len(sys.argv) != 2:
    fail('Aktion fehlt.')

action = sys.argv[1]
data = read_payload()


if action == 'network-list':

    raw = run([
        'docker',
        'network',
        'ls',
        '--format',
        '{{json .}}'
    ])

    result = []

    for line in raw.splitlines():

        if not line.strip():
            continue

        try:
            row = json.loads(line)
        except Exception:
            continue

        result.append(row)

    print(
        json.dumps(
            result,
            ensure_ascii=False
        )
    )


elif action == 'network-inspect':

    network = valid_name(
        data.get('network'),
        'Netzwerkname'
    )

    if not network_exists(network):
        fail('Netzwerk wurde nicht gefunden.', 3)

    raw = run([
        'docker',
        'network',
        'inspect',
        network
    ])

    # Docker liefert bereits JSON.
    print(raw.strip())


elif action == 'network-create':

    network = valid_name(
        data.get('network'),
        'Netzwerkname'
    )

    driver = str(
        data.get('driver') or 'bridge'
    ).strip()

    if driver not in {
        'bridge',
        'overlay',
        'macvlan',
        'ipvlan'
    }:
        fail('Nicht erlaubter Netzwerk-Treiber.')

    if network in PROTECTED:
        fail(
            'Dieser Netzwerkname ist reserviert.'
        )

    if network_exists(network):
        fail(
            'Das Netzwerk existiert bereits.',
            4
        )

    cmd = [
        'docker',
        'network',
        'create',
        '--driver',
        driver
    ]

    internal = bool(data.get('internal'))

    attachable = bool(data.get('attachable'))

    if internal:
        cmd.append('--internal')

    if attachable:
        cmd.append('--attachable')

    cmd.append(network)

    network_id = run(cmd).strip()

    print(
        json.dumps(
            {
                'network': network,
                'id': network_id,
                'driver': driver,
                'internal': internal,
                'attachable': attachable
            },
            ensure_ascii=False
        )
    )


elif action == 'network-remove':

    network = valid_name(
        data.get('network'),
        'Netzwerkname'
    )

    if network in PROTECTED:
        fail(
            'Docker-Standardnetzwerke dürfen '
            'nicht entfernt werden.'
        )

    if not network_exists(network):
        fail(
            'Netzwerk wurde nicht gefunden.',
            3
        )

    run([
        'docker',
        'network',
        'rm',
        network
    ])

    print(
        'Netzwerk entfernt: ' + network
    )


elif action == 'network-connect':

    network = valid_name(
        data.get('network'),
        'Netzwerkname'
    )

    container = valid_name(
        data.get('container'),
        'Containername'
    )

    if not network_exists(network):
        fail(
            'Netzwerk wurde nicht gefunden.',
            3
        )

    if not container_exists(container):
        fail(
            'Container wurde nicht gefunden.',
            3
        )

    run([
        'docker',
        'network',
        'connect',
        network,
        container
    ])

    print(
        container +
        ' wurde mit ' +
        network +
        ' verbunden.'
    )


elif action == 'network-disconnect':

    network = valid_name(
        data.get('network'),
        'Netzwerkname'
    )

    container = valid_name(
        data.get('container'),
        'Containername'
    )

    if network in {'host', 'none'}:
        fail(
            'Diese Verbindung wird nicht '
            'über den Manager getrennt.'
        )

    if not network_exists(network):
        fail(
            'Netzwerk wurde nicht gefunden.',
            3
        )

    if not container_exists(container):
        fail(
            'Container wurde nicht gefunden.',
            3
        )

    force = bool(data.get('force'))

    cmd = [
        'docker',
        'network',
        'disconnect'
    ]

    if force:
        cmd.append('--force')

    cmd.extend([
        network,
        container
    ])

    run(cmd)

    print(
        container +
        ' wurde von ' +
        network +
        ' getrennt.'
    )


else:
    fail('Netzwerk-Aktion nicht erlaubt.')
