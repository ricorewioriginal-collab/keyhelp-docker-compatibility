#!/usr/bin/env python3

import json
import subprocess
from datetime import datetime, timezone
from pathlib import Path

BASE = Path("/opt/docker")
OUT = Path("/var/lib/keyhelp/docker-monitor/projects.json")

COMPOSE_FILES = (
    "compose.yaml",
    "compose.yml",
    "docker-compose.yml",
    "docker-compose.yaml",
)


def command(args, cwd=None, timeout=30):
    try:
        p = subprocess.run(
            args,
            cwd=str(cwd) if cwd else None,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
        )

        return p.returncode, p.stdout.strip(), p.stderr.strip()

    except Exception as exc:
        return 1, "", str(exc)


def git_info(path):
    result = {
        "is_git": False,
        "repository": "",
        "branch": "",
        "commit": "",
        "dirty": False,
    }

    if not (path / ".git").exists():
        return result

    result["is_git"] = True

    rc, out, _ = command(
        ["git", "config", "--get", "remote.origin.url"],
        cwd=path,
    )

    if rc == 0:
        result["repository"] = out

    rc, out, _ = command(
        ["git", "branch", "--show-current"],
        cwd=path,
    )

    if rc == 0:
        result["branch"] = out

    rc, out, _ = command(
        ["git", "rev-parse", "--short", "HEAD"],
        cwd=path,
    )

    if rc == 0:
        result["commit"] = out

    rc, out, _ = command(
        ["git", "status", "--porcelain"],
        cwd=path,
    )

    if rc == 0:
        result["dirty"] = bool(out.strip())

    return result


def compose_file(path):
    for name in COMPOSE_FILES:
        candidate = path / name

        if candidate.is_file():
            return candidate

    return None


def compose_containers(path, compose):
    rc, out, _ = command(
        [
            "docker",
            "compose",
            "-f",
            compose.name,
            "ps",
            "--format",
            "json",
        ],
        cwd=path,
        timeout=30,
    )

    if rc != 0 or not out:
        return []

    containers = []

    # Compose kann JSONL oder JSON-Array liefern.
    try:
        parsed = json.loads(out)

        if isinstance(parsed, dict):
            parsed = [parsed]

        if isinstance(parsed, list):
            rows = parsed
        else:
            rows = []

    except Exception:
        rows = []

        for line in out.splitlines():
            line = line.strip()

            if not line:
                continue

            try:
                value = json.loads(line)

                if isinstance(value, dict):
                    rows.append(value)

            except Exception:
                pass

    for row in rows:
        containers.append({
            "name": row.get("Name", ""),
            "service": row.get("Service", ""),
            "state": row.get("State", ""),
            "status": row.get("Status", ""),
            "image": row.get("Image", ""),
        })

    return containers


def compose_services(path, compose):
    rc, out, _ = command(
        [
            "docker",
            "compose",
            "-f",
            compose.name,
            "config",
            "--services",
        ],
        cwd=path,
        timeout=30,
    )

    if rc != 0:
        return []

    return [
        line.strip()
        for line in out.splitlines()
        if line.strip()
    ]


def collect():
    projects = []

    if not BASE.exists():
        return projects

    for path in sorted(BASE.iterdir()):
        if not path.is_dir():
            continue

        compose = compose_file(path)

        if compose is None:
            continue

        git = git_info(path)
        containers = compose_containers(path, compose)
        services = compose_services(path, compose)

        running = sum(
            1
            for c in containers
            if str(c.get("state", "")).lower() == "running"
        )

        projects.append({
            "name": path.name,
            "path": str(path),
            "compose_file": compose.name,
            "services": services,
            "service_count": len(services),
            "containers": containers,
            "container_count": len(containers),
            "running": running,
            "git": git,
        })

    return projects


def main():
    projects = collect()

    data = {
        "updated": datetime.now(timezone.utc).astimezone().isoformat(),
        "count": len(projects),
        "projects": projects,
    }

    OUT.parent.mkdir(parents=True, exist_ok=True)

    tmp = OUT.with_suffix(".json.tmp")

    tmp.write_text(
        json.dumps(
            data,
            ensure_ascii=False,
            indent=2,
        )
    )

    tmp.chmod(0o644)
    tmp.replace(OUT)

    print(
        f"OK: {len(projects)} Compose-Projekt(e) gefunden."
    )


if __name__ == "__main__":
    main()
